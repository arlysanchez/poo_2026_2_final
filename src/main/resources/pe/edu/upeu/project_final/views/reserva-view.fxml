<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.upeu.project_final.controller.ReservaController"
      spacing="20.0" style="-fx-background-color: #F7F7F7" stylesheets="@style.css">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
       <HBox alignment="CENTER_LEFT" spacing="15.0">
           <Label text="Control de Reserva" textFill="#014074">
               <font><Font name="System Bold" size="20.0"/></font>
           </Label>
           <Region HBox.hgrow="ALWAYS"/>
           <Button mnemonicParsing="false" styleClass="button-login" onAction="#handleNew" text="NUEVA RESERVA"/>
       </HBox>
        <TableView fx:id="TableReserva" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="ColNumero" prefWidth="20.0" text="N°"/>
                <TableColumn fx:id="ColId" prefWidth="10.0" text="ID" visible="false"/>
                <TableColumn fx:id="ColCliente" prefWidth="150.0" text="Cliente"/>
                <TableColumn fx:id="ColHabitacion" prefWidth="100.0" text="N° Habitacion"/>
                <TableColumn fx:id="ColIngreso" prefWidth="100.0" text="Ingreso"/>
                <TableColumn fx:id="ColSalida" prefWidth="100.0" text="Salida"/>
                <TableColumn fx:id="ColTotal" prefWidth="80.0" text="Total"/>
                <TableColumn fx:id="ColEstado" prefWidth="100.0" text="Estado"/>
            </columns>
            <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <children>
            <Button mnemonicParsing="false" onAction="#handleCheckIn" styleClass="button-action-edit" text="Check-In"  />
            <Button mnemonicParsing="false" onAction="#handleCheckOut" styleClass="button-action-delete" text="Check-Out"  />
            <Button mnemonicParsing="false" onAction="#handleCancel" styleClass="button-action-cancel" text="Cancelar"  />
        </children>
        </HBox>
    </children>
</VBox>
